# Copy to supabase/functions/.env for local dev -- auto-loaded when
# `supabase start` brings up the edge-runtime container (confirmed
# empirically: NOT loaded by `docker restart`, only a full stop+start).
# For the hosted project:
#   supabase secrets set --env-file supabase/functions/.env
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
# Local dev: any string matching v1,whsec_<32+ base64 chars> -- the CLI
# validates this format at `supabase start` even though nothing checks it
# against Resend. Production: generated in the Supabase dashboard under
# Auth > Hooks once "Send Email Hook" is enabled there.
SEND_EMAIL_HOOK_SECRET=
