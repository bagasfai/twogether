# Supabase project URL — Project Settings > API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key — safe to expose to the browser, RLS enforces access
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-only, bypasses RLS, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=
